# Copy this file to .dev.vars for local testing only.
# Never commit .dev.vars and never place real secret values in this example.

STORE_ENV=test
SITE_URL=http://localhost:8788

STRIPE_SECRET_KEY=replace_with_test_secret
STRIPE_WEBHOOK_SECRET=replace_with_test_webhook_secret
PRODIGI_API_KEY=replace_with_sandbox_key

GOOGLE_SHEET_ID=replace_with_private_sheet_id
GOOGLE_SHEET_NAME=Orders
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace_with_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

PRODIGI_DEFAULT_TAX_RATE=0.20
PRODIGI_TAX_RATES_JSON={"US":0}
SHIPPING_PROCESSING_RATE=0.035
SHIPPING_HANDLING_CENTS=50
